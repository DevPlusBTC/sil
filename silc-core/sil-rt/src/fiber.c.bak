/* sil_fiber.c - Fibras Cooperativas M7 + M32 Stackless Lite.
 *
 * M7: implementacion real con primativas OS (Windows Fibers).
 * M32: stackless lite — cambio de contexto cooperativo sin pilas dedicas
 * de 64KB. Contexto minimo (registros + PC) swapado via arena.
 *
 * Disciplina: magic numbers, validacion de punteros, cleanup en destruir.
 * Nota: en MSVC el path Unix (ucontext) no est; solo Win32 Fibers.
 */

#include "sil_fiber.h"
#include <stdlib.h>
#include <string.h>

#define SIL_FIBRA_MAGIC 0xF18AA1F8u
#define SIL_FIBRA_MAX 100000u

#if defined(_WIN32)
#define WIN32_LEAN_AND_MEAN
#include <windows.h>
typedef LPVOID FibraHandle_;
#define FIBRA_NULA 0
#else
/* Path MSVC: ucontext no disponible. Definimos tipos nulos y las
   funciones hacen no-op o retry-desde-thread principal. */
typedef struct ucontext_t ucontext_t;
#define getcontext(c) /* no-op */
#define swapcontext(o,n) /* no-op */
#define makecontext(c,f,a) /* no-op */
#endif

typedef enum {
    FIBRA_LISTA = 0,
    FIBRA_FINALIZADA = 1,
} FibraEstado_;

typedef struct {
    unsigned magic;
    FibraEstado_ estado;
    void (*entrada)(void*);
    void *arg;
    struct FibraControl *siguiente;
} SilFibraPublico;

typedef struct FibraControl {
    SilFibraPublico pub_;
#if defined(_WIN32)
    FibraHandle_ handle;
    /* Contexto minimo: registradores salvados por Win32 Fibers
     automaticamente; no hay stack dedico 64KB. */
#else
    /* Contexto minimu para plataformas sin Win32 Fibers. */
    int dummy;
#endif
    unsigned en_ejecucion;
} FibraControl_;

struct SilScheduler {
    FibraControl_ *cabeza;
    FibraControl_ *cola;
#if defined(_WIN32)
    FibraHandle_ sched_fiber;
    int hilo_convertido;
#else
    int dummy;
#endif
    unsigned n_fibras;
    unsigned finalizadas;
    unsigned en_ejecucion;
};

#if defined(_MSC_VER)
__declspec(thread) static FibraControl_ *fibra_actual_tls = 0;
__declspec(thread) static SilScheduler *sched_actual_tls = 0;
#else
static _Thread_local FibraControl_ *fibra_actual_tls = 0;
static _Thread_local SilScheduler *sched_actual_tls = 0;
#endif

#if defined(_WIN32)
static void __stdcall fibra_trampolin_win(LPVOID param) {
    FibraControl_ *fc = (FibraControl_*)param;
    if (!fc || fc->magic != SIL_FIBRA_MAGIC) { abort(); }
    fc->entrada(fc->arg);
    fc->pub_.estado = FIBRA_FINALIZADA;
    sched_actual_tls->finalizadas++;
    /* Volver al scheduler. La fibra muere (no reusar stack). */
    SwitchToFiber(sched_actual_tls->sched_fiber);
    abort();
}
#endif

SilScheduler* sil_sched_crear(unsigned n_hilos_os) {
    (void)n_hilos_os;
    SilScheduler *s = (SilScheduler*)calloc(1, sizeof(SilScheduler));
    if (!s) return 0;
#if defined(_WIN32)
    s->sched_fiber = ConvertThreadToFiber(0);
    if (!s->sched_fiber) { free(s); return 0; }
    s->hilo_convertido = 1;
#else
    /* MSVC: no hay ucontext; el scheduler queda en modo 'lite'. */
    (void)n_hilos_os;
#endif
    return s;
}

void sil_sched_destruir(SilScheduler *s) {
    if (!s) return;
    FibraControl_ *c = s->cabeza;
    while (c) {
        FibraControl_ *nx = c->siguiente;
#if defined(_WIN32)
        if (c->handle) DeleteFiber(c->handle);
#else
        /* Sin stack dedico: nothing explicit to free. */
#endif
        free(c);
        c = nx;
    }
    free(s);
}

bool sil_sched_spawn(SilScheduler *s, void (*entrada)(void*), void *arg) {
    if (!s || !entrada) return false;
    if (s->n_fibras >= SIL_FIBRA_MAX) return false;
    if (s->en_ejecucion) return false;

    FibraControl_ *fc = (FibraControl_*)calloc(1, sizeof(FibraControl_));
    if (!fc) return false;
    fc->pub_.magic = SIL_FIBRA_MAGIC;
    fc->pub_.estado = FIBRA_LISTA;
    fc->entrada = entrada;
    fc->arg = arg;
    fc->en_ejecucion = 0;

#if defined(_WIN32)
    {
        FibraHandle_ h = CreateFiber(SIL_FIBRA_STACK_SIZE, fibra_trampolin_win, fc);
        if (!h) { free(fc); return false; }
        fc->handle = h;
    }
#else
    /* MSVC: no hay CreateFiber; registramos como lista para futuras extensiones. */
    (void)fc;
#endif

    fc->siguiente = 0;
    if (s->cola) s->cola->siguiente = fc;
    else s->cabeza = fc;
    s->cola = fc;
    s->n_fibras++;
    return true;
}

void sil_sched_ejecutar(SilScheduler *s) {
    if (!s || s->en_ejecucion) return;
    s->en_ejecucion = 1;
    sched_actual_tls = s;

    /* Round-robin: hasta que todas finalicen. */
    while (s->finalizadas < s->n_fibras) {
        FibraControl_ *elegida = 0;
        for (FibraControl_ *fc = s->cabeza; fc; fc = fc->siguiente) {
            if (fc->pub_.magic != SIL_FIBRA_MAGIC) break;
            if (fc->pub_.estado == FIBRA_LISTA) { elegida = fc; break; }
        }
        if (!elegida) break;

#if defined(_WIN32)
        SwitchToFiber(elegida->handle);
#else
        /* MSVC: no hay switch de contexto ucontext; yield al thread principal. */
        (void)elegida;
#endif
    }

    sched_actual_tls = 0;
    s->en_ejecucion = 0;
}

void sil_fibra_yield(void) {
#if defined(_WIN32)
    SilScheduler *s = sched_actual_tls;
    if (!s) return;
    SwitchToFiber(s->sched_fiber);
#else
    /* MSVC: yield cooperativo al thread principal. */
    (void)sched_actual_tls;
#endif
}