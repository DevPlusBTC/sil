{
  "name": "sil-language-support",
  "displayName": "SIL Language Support (SMT Verified)",
  "description": "Soporte oficial para el Lenguaje de Intención Semántica con verificación SMT en tiempo real.",
  "version": "1.0.0",
  "publisher": "sil-lang",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "main": "./silc-vscode/out/extension.js",
  "contributes": {
    "languages": [{
      "id": "sil",
      "aliases": ["SIL", "sil"],
      "extensions": [".sil"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "sil",
      "scopeName": "source.sil",
      "path": "./syntaxes/sil.tmLanguage.json"
    }],
    "commands": [
      {
        "command": "sil.compile",
        "title": "SIL: Compilar archivo actual a C99",
        "category": "SIL"
      },
      {
        "command": "sil.verify",
        "title": "SIL: Verificar invariantes SMT del archivo actual",
        "category": "SIL"
      }
    ],
    "keybindings": [
      {
        "command": "sil.compile",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorTextFocus && editorLangId == sil"
      },
      {
        "command": "sil.verify",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus && editorLangId == sil"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./silc-vscode",
    "watch": "tsc -watch -p ./silc-vscode"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "activationEvents": [
    "onLanguage:sil"
  ]
}