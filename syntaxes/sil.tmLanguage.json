{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SIL",
  "scopeName": "source.sil",
  "patterns": [
    {
      "name": "comment.line.semicolon.sil",
      "match": ";.*$"
    },
    {
      "name": "keyword.control.sil",
      "match": "\\b(task|struct|model|memory|variant|case|service|handler|net|protocol|capability|resource|port|bandwidth|module|export|migration|from|to|field|record|default|restrictions|params|returns|requires|ensures|body|if|else|assert|assume|prove|invariant|while|for|let|let-mut|return|request|validate|send|recv|spawn|chan|capacity|io-read|io-write|io-send|io-recv)\\b"
    },
    {
      "name": "storage.type.sil",
      "match": "\\b(i64|f64|booleano|texto|capacidad|void|USD|EUR|list|map|set|tuple)\\b"
    },
    {
      "name": "constant.numeric.sil",
      "match": "\\b[+-]?[0-9]+(\\.[0-9]+)?\\b"
    },
    {
      "name": "constant.language.sil",
      "match": "\\b(verdadero|falso)\\b"
    },
    {
      "name": "string.quoted.double.sil",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.sil",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.operator.sil",
      "match": ">|<|==|!=|>=|<=|\\+|-|\\*|/"
    },
    {
      "name": "punctuation.definition.list.begin.sil",
      "match": "\\("
    },
    {
      "name": "punctuation.definition.list.end.sil",
      "match": "\\)"
    },
    {
      "name": "variable.other.sil",
      "match": "[A-Za-z_][A-Za-z0-9_]*"
    }
  ]
}